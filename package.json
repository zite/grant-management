{
  "name": "grant-management",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "zitejs": "0.9.115"
  },
  "scripts": {
    "dev": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; yarn workspace @project/grant-management dev'",
    "dev:grant-management": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; yarn workspace @project/grant-management dev'",
    "dev:applicant-portal": "sh -c 'set -a; [ -f .env.local ] && . ./.env.local; set +a; yarn workspace @project/applicant-portal dev'",
    "generate": "zitejs generate",
    "check": "zitejs check",
    "build": "yarn workspace @project/grant-management build"
  }
}
